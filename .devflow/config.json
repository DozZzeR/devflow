{
  "language": "en",
  "roles": {
    "explore": {
      "runner": "claude",
      "model": "haiku"
    },
    "design": {
      "runner": "claude",
      "model": "opus"
    },
    "design_complex": {
      "runner": "claude",
      "model": "fable"
    },
    "implement": {
      "runner": "claude",
      "model": "sonnet"
    },
    "verify": {
      "runner": "codex",
      "model": "gpt-6.2-sol"
    },
    "small": {
      "runner": "claude",
      "model": "sonnet"
    }
  },
  "limits": {
    "implement": 3,
    "verify": 2,
    "escalate_after": 2
  },
  "test": {
    "command": "npm test",
    "paths": [
      "test/**",
      "tests/**",
      "**/*.test.*",
      "**/test_*.py"
    ]
  },
  "openspec": {
    "cli": "auto"
  },
  "logs": {
    "keep": 20
  }
}
