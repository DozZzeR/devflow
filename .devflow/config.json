{
  "language": "en",
  "roles": {
    "explore": {
      "runner": "codex",
      "model": "gpt-5.6-luna"
    },
    "design": {
      "runner": "claude",
      "model": "opus"
    },
    "design_complex": {
      "runner": "claude",
      "model": "opus"
    },
    "implement": {
      "runner": "codex",
      "model": "gpt-6.2-sol"
    },
    "verify": {
      "runner": "codex",
      "model": "gpt-6.2-sol"
    },
    "small": {
      "runner": "codex",
      "model": "gpt-6.2-sol"
    }
  },
  "limits": {
    "implement": 3,
    "verify": 2,
    "escalate_after": 2
  },
  "test": {
    "command": "npm test",
    "paths": [
      "test/**",
      "tests/**",
      "**/*.test.*",
      "**/test_*.py"
    ],
    "setup": "npm ci --no-audit --no-fund"
  },
  "build": {
    "generate": "npm run build:plugins",
    "outputs": ["plugins/**"]
  },
  "openspec": {
    "cli": "auto"
  },
  "logs": {
    "keep": 20
  }
}
